{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xbrainlab.local/schemas/moabb-gui-journey-receipt-v2.schema.json",
  "title": "XBrainLab MOABB GUI Journey Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "dataset",
    "subjects",
    "journey_mode",
    "process",
    "source_identity",
    "correlation",
    "stages",
    "artifacts",
    "ui_options",
    "event_class_summary",
    "evaluation",
    "saliency",
    "cancellation",
    "responsiveness",
    "close"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "artifact_type": {
      "const": "xbrainlab.moabb_gui_journey"
    },
    "status": {
      "const": "completed"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "subjects": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "journey_mode": {
      "enum": [
        "cold",
        "replay"
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_process",
        "pid",
        "exit_code",
        "runner_verified",
        "timed_out",
        "duration_seconds",
        "residual_descendant_count",
        "residual_process_group_status",
        "process_receipt",
        "process_receipt_sha256"
      ],
      "properties": {
        "fresh_process": {
          "const": true
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "exit_code": {
          "const": 0
        },
        "runner_verified": {
          "const": true
        },
        "timed_out": {
          "const": false
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "residual_descendant_count": {
          "const": 0
        },
        "residual_process_group_status": {
          "const": "clean"
        },
        "process_receipt": {
          "$ref": "#/$defs/artifactPath"
        },
        "process_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_commit",
        "campaign_plan_sha256",
        "poetry_lock_sha256",
        "dataset_checksum_sha256",
        "environment_identity_sha256",
        "cuda",
        "gpu"
      ],
      "properties": {
        "application_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "campaign_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "poetry_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_checksum_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cuda": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correlation": {
      "$ref": "#/$defs/correlation"
    },
    "stages": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "prefixItems": [
        {
          "$ref": "#/$defs/importBidsFolderStage"
        },
        {
          "$ref": "#/$defs/selectSubjectsStage"
        },
        {
          "$ref": "#/$defs/reviewMetadataStage"
        },
        {
          "$ref": "#/$defs/matchLabelsStage"
        },
        {
          "$ref": "#/$defs/confirmImportStage"
        },
        {
          "$ref": "#/$defs/preprocessStage"
        },
        {
          "$ref": "#/$defs/epochStage"
        },
        {
          "$ref": "#/$defs/splitStage"
        },
        {
          "$ref": "#/$defs/modelStage"
        },
        {
          "$ref": "#/$defs/trainingStage"
        },
        {
          "$ref": "#/$defs/evaluationStage"
        },
        {
          "$ref": "#/$defs/computeSaliencyStage"
        },
        {
          "$ref": "#/$defs/saliencyMapStage"
        },
        {
          "$ref": "#/$defs/spectrogramStage"
        },
        {
          "$ref": "#/$defs/cleanCloseStage"
        }
      ],
      "items": false
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenshots",
        "training_metrics",
        "saliency_map",
        "spectrogram"
      ],
      "properties": {
        "screenshots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "import_bids_folder",
            "select_subjects",
            "review_metadata",
            "match_labels",
            "confirm_import",
            "preprocess",
            "epoch",
            "split",
            "model",
            "training",
            "evaluation",
            "compute_saliency",
            "saliency_map",
            "spectrogram",
            "clean_close"
          ],
          "properties": {
            "import_bids_folder": {
              "$ref": "#/$defs/artifactPath"
            },
            "select_subjects": {
              "$ref": "#/$defs/artifactPath"
            },
            "review_metadata": {
              "$ref": "#/$defs/artifactPath"
            },
            "match_labels": {
              "$ref": "#/$defs/artifactPath"
            },
            "confirm_import": {
              "$ref": "#/$defs/artifactPath"
            },
            "preprocess": {
              "$ref": "#/$defs/artifactPath"
            },
            "epoch": {
              "$ref": "#/$defs/artifactPath"
            },
            "split": {
              "$ref": "#/$defs/artifactPath"
            },
            "model": {
              "$ref": "#/$defs/artifactPath"
            },
            "training": {
              "$ref": "#/$defs/artifactPath"
            },
            "evaluation": {
              "$ref": "#/$defs/artifactPath"
            },
            "compute_saliency": {
              "$ref": "#/$defs/artifactPath"
            },
            "saliency_map": {
              "$ref": "#/$defs/artifactPath"
            },
            "spectrogram": {
              "$ref": "#/$defs/artifactPath"
            },
            "clean_close": {
              "$ref": "#/$defs/artifactPath"
            }
          }
        },
        "training_metrics": {
          "$ref": "#/$defs/trainingMetrics"
        },
        "saliency_map": {
          "$ref": "#/$defs/artifactPath"
        },
        "spectrogram": {
          "$ref": "#/$defs/artifactPath"
        }
      }
    },
    "ui_options": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "training_epochs",
        "repeats",
        "folds",
        "selection_policy",
        "event_value_decisions",
        "filtering",
        "epoch",
        "split",
        "model",
        "training",
        "saliency"
      ],
      "properties": {
        "training_epochs": {
          "const": 1
        },
        "repeats": {
          "const": 1
        },
        "folds": {
          "const": 1
        },
        "selection_policy": {
          "const": "product_recommended_with_pinned_semantics"
        },
        "event_value_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_value",
              "use",
              "class_name",
              "selection_basis"
            ],
            "properties": {
              "event_value": {
                "type": "string",
                "minLength": 1
              },
              "use": {
                "enum": ["class", "ignore"]
              },
              "class_name": {
                "type": "string"
              },
              "selection_basis": {
                "enum": ["oracle_expected_class", "oracle_nonclass_event"]
              }
            }
          }
        },
        "filtering": {
          "type": "object",
          "minProperties": 1
        },
        "epoch": {
          "type": "object",
          "minProperties": 1
        },
        "split": {
          "type": "object",
          "minProperties": 1
        },
        "model": {
          "type": "object",
          "minProperties": 1
        },
        "training": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "selected_device",
            "runtime_devices"
          ]
        },
        "saliency": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "event_class_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_events",
        "observed_events",
        "expected_classes",
        "observed_classes",
        "review_mapping",
        "applied_event_catalog",
        "evaluation_class_labels",
        "saliency_class_mapping"
      ],
      "properties": {
        "expected_events": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "observed_events": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "expected_classes": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "observed_classes": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "review_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reviewSemanticRow"
          }
        },
        "applied_event_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reviewSemanticRow"
          }
        },
        "evaluation_class_labels": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "saliency_class_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/saliencyClassRow"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation",
        "metrics",
        "output_numeric_summary"
      ],
      "properties": {
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "metrics": {
          "$ref": "#/$defs/evaluationMetrics"
        },
        "output_numeric_summary": {
          "$ref": "#/$defs/evaluationOutputNumericSummary"
        }
      }
    },
    "saliency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_compute_clicked",
        "map_rendered",
        "spectrogram_rendered",
        "correlation",
        "map_correlation",
        "spectrogram_correlation",
        "map_numeric_summary",
        "spectrogram_numeric_summary"
      ],
      "properties": {
        "explicit_compute_clicked": {
          "const": true
        },
        "map_rendered": {
          "const": true
        },
        "spectrogram_rendered": {
          "const": true
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "map_correlation": {
          "$ref": "#/$defs/correlation"
        },
        "spectrogram_correlation": {
          "$ref": "#/$defs/correlation"
        },
        "map_numeric_summary": {
          "$ref": "#/$defs/numericSummary"
        },
        "spectrogram_numeric_summary": {
          "$ref": "#/$defs/numericSummary"
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "target",
        "attempted",
        "operation_id",
        "stage_at_cancel",
        "phase_at_cancel",
        "progress_at_cancel",
        "terminal_status",
        "retry_succeeded",
        "state_before",
        "state_after",
        "state_preserved",
        "review_session_before",
        "review_session_after",
        "same_review_session_retry"
      ],
      "properties": {
        "partition": {
          "enum": [
            "import_review",
            "apply_epoch",
            "training_saliency"
          ]
        },
        "target": {
          "enum": [
            "import",
            "review",
            "apply",
            "epoch",
            "training",
            "saliency"
          ]
        },
        "attempted": {
          "type": "boolean"
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stage_at_cancel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "phase_at_cancel": {
          "enum": [
            "running",
            null
          ]
        },
        "progress_at_cancel": {
          "oneOf": [
            {
              "$ref": "#/$defs/cancellationProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_status": {
          "enum": [
            "cancelled",
            "not_run"
          ]
        },
        "retry_succeeded": {
          "type": "boolean"
        },
        "state_before": {
          "oneOf": [
            {
              "$ref": "#/$defs/workflowStateIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_after": {
          "oneOf": [
            {
              "$ref": "#/$defs/workflowStateIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_preserved": {
          "type": "boolean"
        },
        "review_session_before": {
          "oneOf": [
            {
              "$ref": "#/$defs/reviewSessionIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_session_after": {
          "oneOf": [
            {
              "$ref": "#/$defs/reviewSessionIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "same_review_session_retry": {
          "type": "boolean"
        },
        "stop_handler_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        }
      }
    },
    "responsiveness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_click_ack_seconds",
        "max_progress_silence_seconds"
      ],
      "properties": {
        "max_click_ack_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_progress_silence_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean",
        "forced",
        "terminal_snapshot_observed",
        "application_closed",
        "close_attempt_id",
        "pre_close_application_idle",
        "pre_close_remaining_workers",
        "pre_close_remaining_subprocesses"
      ],
      "properties": {
        "clean": {
          "const": true
        },
        "forced": {
          "const": false
        },
        "terminal_snapshot_observed": {
          "const": true
        },
        "application_closed": {
          "const": true
        },
        "close_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "pre_close_application_idle": {
          "const": true
        },
        "pre_close_remaining_workers": {
          "const": 0
        },
        "pre_close_remaining_subprocesses": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowStateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_generation",
        "publication_revision",
        "application_state_sha256",
        "workflow_inputs_sha256",
        "saliency_output_sha256",
        "finished_run_count"
      ],
      "properties": {
        "publication_generation": {
          "type": "integer",
          "minimum": 0
        },
        "publication_revision": {
          "type": "integer",
          "minimum": 1
        },
        "application_state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_inputs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "saliency_output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "finished_run_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewSessionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_id",
        "candidate_id",
        "preview_id",
        "publication_generation"
      ],
      "properties": {
        "scan_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "preview_id": {
          "type": "string",
          "minLength": 1
        },
        "publication_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewSemanticRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_value",
        "event_role",
        "keep_event",
        "use_as_class",
        "class_name",
        "sources"
      ],
      "properties": {
        "event_value": {
          "type": "string",
          "minLength": 1
        },
        "event_role": {
          "type": "string",
          "minLength": 1
        },
        "keep_event": {
          "type": "boolean"
        },
        "use_as_class": {
          "type": "boolean"
        },
        "class_name": {
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "saliencyClassRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_index",
        "event_code",
        "class_name"
      ],
      "properties": {
        "class_index": {
          "type": "integer",
          "minimum": 0
        },
        "event_code": {
          "type": "string",
          "minLength": 1
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trainingMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Train Loss",
        "Train Acc",
        "Val Loss",
        "Val Acc",
        "Test Acc",
        "LR"
      ],
      "properties": {
        "Train Loss": {
          "type": "number"
        },
        "Train Acc": {
          "type": "number"
        },
        "Val Loss": {
          "type": "number"
        },
        "Val Acc": {
          "type": "number"
        },
        "Test Acc": {
          "type": "number"
        },
        "LR": {
          "type": "number"
        }
      }
    },
    "evaluationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Precision",
        "Recall",
        "F1-Score",
        "Support"
      ],
      "properties": {
        "Precision": {
          "type": "number"
        },
        "Recall": {
          "type": "number"
        },
        "F1-Score": {
          "type": "number"
        },
        "Support": {
          "type": "number"
        }
      }
    },
    "numericSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "finite_count",
        "nonfinite_count",
        "minimum",
        "maximum"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "finite_count": {
          "type": "integer",
          "minimum": 1
        },
        "nonfinite_count": {
          "const": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "evaluationOutputNumericSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "dtype",
        "count",
        "finite_count",
        "nonfinite_count",
        "minimum",
        "maximum"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false
        },
        "dtype": {
          "type": "string",
          "pattern": "^(float|int|uint)[0-9]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "finite_count": {
          "type": "integer",
          "minimum": 1
        },
        "nonfinite_count": {
          "const": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "fold",
        "split",
        "publication_generation",
        "training_generation",
        "training_boundary_stable",
        "split_specification_fingerprint",
        "split_epoch_revision",
        "producer_identities"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "fold": {
          "type": "integer",
          "minimum": 0
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "publication_generation": {
          "type": "integer",
          "minimum": 0
        },
        "training_generation": {
          "type": "integer",
          "minimum": 0
        },
        "training_boundary_stable": {
          "const": true
        },
        "split_specification_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "split_epoch_revision": {
          "type": "integer",
          "minimum": 1
        },
        "producer_identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/producerIdentity"
          }
        }
      }
    },
    "producerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "dataset_fingerprint",
        "split_fingerprint",
        "run_fingerprint",
        "model_fingerprint"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "split_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "run_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "model_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cancellationProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
